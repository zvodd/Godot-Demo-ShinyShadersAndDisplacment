[gd_resource type="Shader" format=3 uid="uid://cl8swi1rfidwt"]

[resource]
code = "// NOTE: Shader automatically converted from Godot Engine 4.7.2.stable.mono's StandardMaterial3D.

shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

uniform vec4 albedo : source_color;
uniform sampler2D texture_albedo : source_color, filter_linear_mipmap, repeat_enable;
uniform ivec2 albedo_texture_size;
uniform float roughness : hint_range(0.0, 1.0);
uniform float specular : hint_range(0.0, 1.0, 0.01);
uniform float metallic : hint_range(0.0, 1.0, 0.01);


uniform vec3 point_center = vec3(0.0);
uniform float radius = 5.0;
uniform float offset_factor = 2.0;

void vertex()
{
    // Position of this particular MultiMesh instance.
    vec3 instance_position = MODEL_MATRIX[3].xyz;

    float distance_from_center =
        distance(instance_position.xz, point_center.xz);

    float factor =
        clamp(distance_from_center / radius, 0.0, 1.0);

    VERTEX.y += factor * offset_factor;
}

void fragment() {
	vec2 base_uv = UV;

	vec4 albedo_tex = texture(texture_albedo, base_uv);
	ALBEDO = albedo.rgb * albedo_tex.rgb;

	METALLIC = metallic;
	SPECULAR = specular;
	ROUGHNESS = roughness;
}
"
